########################################
# Database (Postgres)
# - POSTGRES_*: used by docker-compose to start the DB
# - DATABASE_URL: async SQLAlchemy URL used by the API
# - SYNC_DATABASE_URL: sync SQLAlchemy URL used by Celery workers
########################################
POSTGRES_DB=botbrawl
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpassword
DATABASE_URL=postgresql+asyncpg://botuser:botpassword@db:5432/botbrawl 
SYNC_DATABASE_URL=postgresql://botuser:botpassword@db:5432/botbrawl

########################################
# Admin, feature flags, boot options
# - ADMIN_TOKEN: required header for admin APIs (X-Admin-Token)
# - ADMIN_PASSWORD: legacy password for team admin endpoints
# - ENABLE_DUO / ENABLE_QUAD: enable modes in scheduling
# - BASELINE_ENABLED: allow using baselines for calibration/ongoing
# - BASELINES_VISIBLE: show baselines on public leaderboard
# - RESET_DB: drop & recreate tables on API startup (dev only)
# - SEED_BASELINES_ON_START: auto-seed Baseline A/B/C on startup
# - ENABLE_CELERY_BEAT: enable periodic jobs (queue consumer + scheduler + sigma inflation)
# - TZ: timezone for Celery beat schedules
########################################
ADMIN_PASSWORD=password
ADMIN_TOKEN=token
ENABLE_DUO=true
ENABLE_QUAD=true
BASELINE_ENABLED=true
BASELINES_VISIBLE=false
RESET_DB=false
SEED_BASELINES_ON_START=false
ENABLE_CELERY_BEAT=true
TZ=UTC

########################################
# Scheduling & rating knobs
# - MAX_REPEAT_WINDOW_HOURS: suppress rematches within this window
# - DAILY_*: per-team per-mode target matches/day
# - SIGMA_TARGET / EXTRA_MATCH_PER_SIGMA / MAX_DAILY_*: dynamic extras until uncertainty stabilizes
# - BAND_WIDTH_*: μ-band for nearby opponents
# - CAL_*: counts for calibration batches
# - RATE_LIMIT_SUBMIT_EVAL_SECONDS: per-team cooldown (in seconds) for Submit for Evaluation
########################################
MAX_REPEAT_WINDOW_HOURS=1
DAILY_DUO=4
DAILY_QUAD=2
SIGMA_TARGET=2.5
EXTRA_MATCH_PER_SIGMA=3.0
MAX_DAILY_EXTRA=10
MAX_DAILY_DUO=10
MAX_DAILY_QUAD=4
BAND_WIDTH_DUO=4.0
BAND_WIDTH_QUAD=3.5
MAX_CALIB_GAP=8.0
CAL_DUO_BASELINE=2
CAL_DUO_NEAR=6
CAL_DUO_FOLLOW=8
CAL_QUAD_BASELINE=2
CAL_QUAD_NEAR=4
CAL_QUAD_FOLLOW=6
RATE_LIMIT_SUBMIT_EVAL_SECONDS=30

# Unbounded scheduling (optional)
# - When enabled, the ongoing scheduler ignores daily caps for teams whose
#   uncertainty (sigma) is above SIGMA_TARGET, and enqueues at least
#   UNBOUNDED_PER_RUN matches per run (subject to opponent availability and
#   recent-pair suppression). When sigma ≤ SIGMA_TARGET, it stops extra enqueues.
UNBOUNDED_UNTIL_SIGMA=true
UNBOUNDED_PER_RUN=20

########################################
# Redis & Celery
# - REDIS_URL: cache (leaderboard etc.)
# - CELERY_BROKER_URL / CELERY_RESULT_BACKEND: Celery queues/results
#   Use different DB indices to isolate cache vs workers
########################################
REDIS_PASSWORD=your-secure-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1

########################################
# Flower (Celery dashboard)
########################################
FLOWER_USER=admin
FLOWER_PASSWORD=password

########################################
# Maps & data dirs (optional)
# - MAP_RULES_PATH: override default rules file for map generator
# - FORCE_MAP_SEED: force a fixed seed for matches (QA)
# - DATA_DIR: override data root for teams/matches (defaults differ per module)
########################################
# MAP_RULES_PATH=
# FORCE_MAP_SEED=
# DATA_DIR=
