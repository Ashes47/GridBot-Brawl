########################################
# Database (Postgres)
########################################
POSTGRES_DB=botbrawl
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpassword
DATABASE_URL=postgresql+asyncpg://botuser:botpassword@db:5432/botbrawl 
SYNC_DATABASE_URL=postgresql://botuser:botpassword@db:5432/botbrawl

########################################
# Admin, feature flags, boot options
########################################
ADMIN_PASSWORD=adminchangeme
ADMIN_TOKEN=dev-admin-token-please-change
ENABLE_DUO=true
ENABLE_QUAD=false
BASELINE_ENABLED=true
BASELINES_VISIBLE=false
RESET_DB=false
SEED_BASELINES_ON_START=true
ENABLE_CELERY_BEAT=true
TZ=UTC

########################################
# Scheduling & rating knobs
########################################
MAX_REPEAT_WINDOW_HOURS=24
DAILY_DUO=2
DAILY_QUAD=1
# Dynamic scheduling for uncertainty
SIGMA_TARGET=2.5
EXTRA_MATCH_PER_SIGMA=1.0
MAX_DAILY_EXTRA=3
MAX_DAILY_DUO=5
MAX_DAILY_QUAD=4
BAND_WIDTH_DUO=3.0
BAND_WIDTH_QUAD=3.5
CAL_DUO_BASELINE=2
CAL_DUO_NEAR=4
CAL_DUO_FOLLOW=6
CAL_QUAD_BASELINE=2
CAL_QUAD_NEAR=4
CAL_QUAD_FOLLOW=6
RATE_LIMIT_SUBMIT_EVAL_SECONDS=3600

########################################
# Redis & Celery
########################################
REDIS_PASSWORD=your-secure-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1

########################################
# Flower
########################################
FLOWER_USER=admin
FLOWER_PASSWORD=password

########################################
# Maps & data dirs (optional)
########################################
# MAP_RULES_PATH=
# FORCE_MAP_SEED=
# DATA_DIR=
